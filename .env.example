# Application Configuration
MONIC_APP_NAME=Monic

# Docker Monitoring (label-based discovery, interval in seconds, default: 300)
MONIC_CHECK_DOCKER_INTERVAL=300

# System Monitoring
MONIC_CHECK_SYSTEM_INTERVAL=60
MONIC_CHECK_SYSTEM_CPU_THRESHOLD=80
MONIC_CHECK_SYSTEM_MEMORY_THRESHOLD=85
MONIC_CHECK_SYSTEM_DISK_THRESHOLD=90

# HTTP Server (used for stats page)
MONIC_HTTP_SERVER_PORT=8765
MONIC_HTTP_SERVER_USERNAME=admin
MONIC_HTTP_SERVER_PASSWORD=***
# Telegram Alerting (optional)
#MONIC_ALERTING_TELEGRAM_BOT_TOKEN=your-bot-token
#MONIC_ALERTING_TELEGRAM_CHAT_ID=your-chat-id

# Email Alerting (optional)
#MONIC_ALERTING_EMAIL_SMTP_HOST=smtp.example.com
#MONIC_ALERTING_EMAIL_SMTP_PORT=587
#MONIC_ALERTING_EMAIL_USERNAME=user@example.com
#MONIC_ALERTING_EMAIL_PASSWORD=secret...n
# Mailgun Alerting (optional)
#MONIC_ALERTING_MAILGUN_API_KEY=your-mailgun-api-key
#MONIC_ALERTING_MAILGUN_DOMAIN=your-domain.com

# Daily Digest (enabled by default, sends at midnight UTC)
# Set MONIC_DIGEST_ENABLED=false to disable
MONIC_DIGEST_ENABLED=true
